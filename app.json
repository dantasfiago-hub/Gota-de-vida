{
  "expo": {
    "name": "Gota de Vida",
    "slug": "gota-de-vida",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gotadevida",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.ufrn.gotadevida"
    },
    "android": {
      "package": "br.ufrn.gotadevida",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#C62828"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização para encontrar hemocentros próximos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78080a23-f0eb-45eb-837b-9ca2f60097aa"
      }
    }
  }
}
